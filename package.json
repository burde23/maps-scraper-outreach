{
  "name": "maps-scraper-outreach",
  "version": "1.0.0",
  "description": "Buscador General de Google Maps con Generador de Excel y WhatsApp Outreach por Secciones (100% Local)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "install-all": "npm install && npm install --prefix frontend",
    "playwright-install": "npx playwright install chromium"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0-rc.12",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "playwright": "^1.50.0"
  }
}
